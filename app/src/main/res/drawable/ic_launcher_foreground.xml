<?xml version="1.0" encoding="utf-8"?>
<!--
  Queen tiara — the same shape used for the Queen face card (FaceCardIcons.kt),
  drawn in a 0..100 space and scaled into the adaptive-icon safe zone via the
  group transform.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:translateX="24"
        android:translateY="25">
        <!-- Tiara band with five spikes (ascending to the centre). -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M8,78 L92,78 L92,58 L85,42 L76,58 L68,32 L58,58 L50,20 L42,58 L32,32 L24,58 L15,42 L8,58 Z" />
        <!-- Pearls on each spike tip. -->
        <path android:fillColor="#FFFFFF" android:pathData="M10,38 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
        <path android:fillColor="#FFFFFF" android:pathData="M27,28 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
        <path android:fillColor="#FFFFFF" android:pathData="M44,14 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 Z" />
        <path android:fillColor="#FFFFFF" android:pathData="M63,28 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
        <path android:fillColor="#FFFFFF" android:pathData="M80,38 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
        <!-- Centre band gem. -->
        <path android:fillColor="#FFFFFF" android:pathData="M45,70 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
    </group>
</vector>
